# ==============================================================================
# SENTINELX - PRODUCTION ENVIRONMENT CONFIGURATION (.env.production.example)
# ==============================================================================
# Hardened zero-trust configuration.
#
# INVARIANT: Application strictly FAILS TO START if:
#   - DEBUG=true
#   - Insecure or default credentials are detected
#   - Wildcard CORS ('*') is configured
#   - DATABASE_URL references localhost or sqlite
#   - OPA_FAIL_CLOSED=false
#
# All credentials MUST be injected via secure secret store (e.g. HashiCorp Vault,
# AWS Secrets Manager, Kubernetes Secrets). DO NOT STORE SECRETS IN THIS FILE.
# ==============================================================================

# Runtime
APP_ENV=production
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Security (Production Secret Key - Minimum 64-char high-entropy cryptographic key)
SECRET_KEY=PROD_REPLACE_WITH_HIGH_ENTROPY_64_CHAR_KEY_FROM_SECRETS_MANAGER
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=3
ALGORITHM=HS256

# Strict CORS: Explicit institutional domain origin only, NO WILDCARDS
ALLOWED_ORIGINS=https://sentinelx.intelligence.gov.in,http://localhost:8080

# Production PostgreSQL Cluster (TLS Required, No localhost/sqlite)
DATABASE_URL=postgresql://sentinelx_prod:PROD_DB_PASSWORD@pg-primary.prod.internal:5432/sentinelx_prod?sslmode=verify-full&sslrootcert=/etc/ssl/certs/pg-ca.pem
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30

# Production Neo4j Enterprise Cluster
NEO4J_URI=neo4j+s://neo4j-cluster.prod.internal:7687
NEO4J_USERNAME=sentinelx_admin
NEO4J_PASSWORD=PROD_NEO4J_PASSWORD_FROM_VAULT
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT_SEC=10.0

# S3 Air-Gapped Object Storage (WORM / Object Lock)
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://s3-vault.prod.internal
S3_ACCESS_KEY=PROD_S3_KEY_FROM_VAULT
S3_SECRET_KEY=PROD_S3_SECRET_FROM_VAULT
S3_BUCKET_NAME=sentinelx-evidence-vault-prod
S3_REGION=ap-south-1
S3_OBJECT_LOCK_ENABLED=true

# Production OpenSearch Cluster
OPENSEARCH_URL=https://opensearch.prod.internal:9200
OPENSEARCH_USERNAME=sentinelx_es_prod
OPENSEARCH_PASSWORD=PROD_OPENSEARCH_PASSWORD_FROM_VAULT
OPENSEARCH_VERIFY_CERTS=true

# Production OPA (Mandatory Fail-Closed)
OPA_URL=http://opa.prod.internal:8181
OPA_FAIL_CLOSED=true

# Production Redis Cluster
REDIS_URL=rediss://redis.prod.internal:6379/0?ssl_cert_reqs=required

# Production LiveKit SFU
LIVEKIT_URL=wss://voice.sentinelx.intelligence.gov.in/webrtc
LIVEKIT_API_KEY=PROD_LIVEKIT_KEY_FROM_VAULT
LIVEKIT_API_SECRET=PROD_LIVEKIT_SECRET_FROM_VAULT
STT_PROVIDER=livekit
TTS_PROVIDER=fish_audio
REASONING_PROVIDER=deterministic_mock

# Production Telemetry & Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector.prod.internal:4317
OTEL_SERVICE_NAME=sentinelx-prod-api
AUDIT_STORAGE_BACKEND=postgres
AUDIT_FAIL_CLOSED=true
