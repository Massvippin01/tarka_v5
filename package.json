{
  "name": "tarka-root",
  "version": "1.0.0",
  "private": true,
  "description": "TARKA - AI-Powered Cyber Fraud Investigation & Attribution Platform",
  "scripts": {
    "dev": "npm --prefix frontend run dev:all",
    "dev:all": "npm --prefix frontend run dev:all",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "python -m uvicorn app.main:app --app-dir backend --port 8000",
    "build": "npm --prefix frontend run build",
    "lint": "npm --prefix frontend run lint",
    "test:frontend": "cd frontend && npx vitest run",
    "test:backend": "python -m pytest backend/tests -q --ignore=backend/tests/test_sarvam_live_smoke.py",
    "test": "npm run test:frontend && npm run test:backend"
  }
}
