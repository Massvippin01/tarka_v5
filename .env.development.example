# ==============================================================================
# SENTINELX - DEVELOPMENT ENVIRONMENT CONFIGURATION (.env.development.example)
# ==============================================================================
# Safe development defaults for local machine execution.
# Permissive local mock fallbacks enabled. NOT FOR STAGING OR PRODUCTION.
# ==============================================================================

# Runtime
APP_ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Security (Development Only Insecure Keys)
SECRET_KEY=sentinelx_development_secret_key_minimum_32_characters_for_local_testing
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=14
ALGORITHM=HS256
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8080

# Database & Graph (Local Docker / Standalone Instances)
DATABASE_URL=postgresql://sentinelx_user:sentinelx_dev_secret@localhost:5432/sentinelx
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=2
DB_POOL_TIMEOUT=30

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=sentinelx_dev_secret
NEO4J_MAX_CONNECTION_POOL_SIZE=20
NEO4J_CONNECTION_TIMEOUT_SEC=10.0

# Evidence Storage (Local Filesystem Mode)
STORAGE_BACKEND=filesystem
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=sentinelx_minio
S3_SECRET_KEY=sentinelx_dev_secret
S3_BUCKET_NAME=sentinelx-evidence
S3_REGION=us-east-1
S3_OBJECT_LOCK_ENABLED=false

# Search Engine (Local Dev OpenSearch)
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=SentinelX_DevPass123!
OPENSEARCH_VERIFY_CERTS=false

# Governance & Policy (Local OPA)
OPA_URL=http://localhost:8181
OPA_FAIL_CLOSED=false

# Session Cache
REDIS_URL=redis://localhost:6379/0

# Voice & Reasoning (Mock Providers)
LIVEKIT_URL=wss://sentinelx-livekit.local/webrtc
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
STT_PROVIDER=mock
TTS_PROVIDER=mock
REASONING_PROVIDER=deterministic_mock

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=sentinelx-dev-api
AUDIT_STORAGE_BACKEND=memory
AUDIT_FAIL_CLOSED=false
