# ==============================================================================
# SENTINELX - BASE ENVIRONMENT TEMPLATE (.env.example)
# ==============================================================================
# Copy this template to .env or backend/.env and populate for your environment.
#
# ANNOTATION KEY:
#   [REQUIRED]            - Must be set for the application to function
#   [OPTIONAL]            - Has safe fallback defaults if omitted
#   [DEVELOPMENT ONLY]    - Permitted only in local development / test modes
#   [STAGING REQUIRED]    - Required in staging deployment
#   [PRODUCTION REQUIRED] - Mandatory in production; application fails to start if omitted or default
#   [EXTERNAL DEPENDENCY] - Connects to an external service or cloud provider
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE APPLICATION RUNTIME
# ------------------------------------------------------------------------------
# [REQUIRED] Operating environment tier: development | staging | production | test
APP_ENV=development

# [REQUIRED] Enable debug logging and verbose tracebacks. MUST be false in staging/prod.
DEBUG=true

# [OPTIONAL] API HTTP server bind host and port
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# 2. SECURITY & CRYPTOGRAPHY
# ------------------------------------------------------------------------------
# [PRODUCTION REQUIRED] Secret key for signing session tokens and credentials.
# In production, must be >= 32 characters generated via high-entropy source:
#   e.g.: openssl rand -hex 32
SECRET_KEY=sentinelx_development_secret_key_minimum_32_characters_for_local_testing

# [OPTIONAL] Session token expiration windows
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# [REQUIRED] Comma-separated list of allowed CORS origins.
# Wildcard '*' is prohibited in staging and production.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:8080

# ------------------------------------------------------------------------------
# 3. TRANSACTIONAL DATABASE - POSTGRESQL
# ------------------------------------------------------------------------------
# [PRODUCTION REQUIRED] [EXTERNAL DEPENDENCY] PostgreSQL connection URL.
# In production, cannot be localhost, 127.0.0.1, or sqlite.
DATABASE_URL=postgresql://sentinelx_user:sentinelx_dev_secret@localhost:5432/sentinelx
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# 4. KNOWLEDGE GRAPH - NEO4J
# ------------------------------------------------------------------------------
# [PRODUCTION REQUIRED] [EXTERNAL DEPENDENCY] Neo4j Bolt connection URI and credentials.
# Default/placeholder passwords trigger a startup failure in staging/production.
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=sentinelx_dev_secret
NEO4J_MAX_CONNECTION_POOL_SIZE=50
NEO4J_CONNECTION_TIMEOUT_SEC=10.0

# ------------------------------------------------------------------------------
# 5. EVIDENCE CONTENT-ADDRESSED STORAGE - S3 / MINIO
# ------------------------------------------------------------------------------
# [REQUIRED] Storage backend mode: filesystem (dev/test only) | s3 (staging/prod)
STORAGE_BACKEND=filesystem

# [STAGING REQUIRED] [PRODUCTION REQUIRED] [EXTERNAL DEPENDENCY]
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=sentinelx_minio
S3_SECRET_KEY=sentinelx_dev_secret
S3_BUCKET_NAME=sentinelx-evidence
S3_REGION=us-east-1
S3_OBJECT_LOCK_ENABLED=false

# ------------------------------------------------------------------------------
# 6. DERIVED SEARCH PROJECTION - OPENSEARCH
# ------------------------------------------------------------------------------
# [STAGING REQUIRED] [PRODUCTION REQUIRED] [EXTERNAL DEPENDENCY]
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_USERNAME=admin
OPENSEARCH_PASSWORD=SentinelX_DevPass123!
OPENSEARCH_VERIFY_CERTS=false

# ------------------------------------------------------------------------------
# 7. STATUTORY GOVERNANCE & POLICY - OPEN POLICY AGENT (OPA)
# ------------------------------------------------------------------------------
# [REQUIRED] [EXTERNAL DEPENDENCY] Open Policy Agent HTTP server URL
OPA_URL=http://localhost:8181

# [PRODUCTION REQUIRED] Fail closed if OPA is unreachable. MUST be true in production.
OPA_FAIL_CLOSED=true

# ------------------------------------------------------------------------------
# 8. SESSION & CACHE - REDIS
# ------------------------------------------------------------------------------
# [OPTIONAL] [EXTERNAL DEPENDENCY] Redis connection URL
REDIS_URL=redis://localhost:6379/0

# ------------------------------------------------------------------------------
# 9. REALTIME VOICE - LIVEKIT & SPEECH PROVIDERS
# ------------------------------------------------------------------------------
# [OPTIONAL] [EXTERNAL DEPENDENCY] LiveKit WebRTC server URL and credentials
LIVEKIT_URL=wss://sentinelx-livekit.local/webrtc
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# [OPTIONAL] Speech-to-Text provider: mock | livekit
STT_PROVIDER=mock

# [OPTIONAL] Text-to-Speech provider: mock | fish_audio
TTS_PROVIDER=mock

# ------------------------------------------------------------------------------
# 10. REASONING & AI PROVIDERS
# ------------------------------------------------------------------------------
# [OPTIONAL] Reasoning provider implementation: deterministic_mock | gemini
REASONING_PROVIDER=deterministic_mock

# [OPTIONAL] [EXTERNAL DEPENDENCY] Google Gemini API Key (required only if REASONING_PROVIDER=gemini)
# GEMINI_API_KEY=your_gemini_api_key_here

# ------------------------------------------------------------------------------
# 11. OBSERVABILITY & AUDIT
# ------------------------------------------------------------------------------
# [OPTIONAL] [EXTERNAL DEPENDENCY] OpenTelemetry collector endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=sentinelx-api

# [OPTIONAL] Audit ledger persistence backend: memory | postgres
AUDIT_STORAGE_BACKEND=memory
AUDIT_FAIL_CLOSED=true