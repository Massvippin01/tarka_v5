# ==============================================================================
# SENTINELX - STAGING ENVIRONMENT CONFIGURATION (.env.staging.example)
# ==============================================================================
# Pre-production validation environment. Mirrors production security posture
# against isolated staging infrastructure.
#
# INVARIANT: Application fails to start if default development credentials remain.
# ==============================================================================

# Runtime
APP_ENV=staging
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Security (Staging Secrets - Injected via CI/CD Secret Store)
SECRET_KEY=PLACEHOLDER_STAGING_KEY_MINIMUM_32_CHARS_GENERATE_VIA_SECRET_STORE
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256
ALLOWED_ORIGINS=https://staging.sentinelx.internal,http://localhost:8080

# Staging PostgreSQL Cluster
DATABASE_URL=postgresql://sentinelx_stage_user:STAGE_DB_PASSWORD@pg-stage.internal:5432/sentinelx_stage
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30

# Staging Neo4j Cluster
NEO4J_URI=bolt://neo4j-stage.internal:7687
NEO4J_USERNAME=sentinelx_stage
NEO4J_PASSWORD=STAGE_NEO4J_PASSWORD_FROM_SECRETS_STORE
NEO4J_MAX_CONNECTION_POOL_SIZE=30
NEO4J_CONNECTION_TIMEOUT_SEC=10.0

# Staging S3 Storage
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=https://s3-stage.internal
S3_ACCESS_KEY=STAGE_S3_ACCESS_KEY
S3_SECRET_KEY=STAGE_S3_SECRET_KEY
S3_BUCKET_NAME=sentinelx-evidence-staging
S3_REGION=ap-south-1
S3_OBJECT_LOCK_ENABLED=false

# Staging OpenSearch Cluster
OPENSEARCH_URL=https://opensearch-stage.internal:9200
OPENSEARCH_USERNAME=sentinelx_stage_os
OPENSEARCH_PASSWORD=STAGE_OPENSEARCH_PASSWORD
OPENSEARCH_VERIFY_CERTS=true

# Staging OPA (Enforces fail-closed)
OPA_URL=http://opa-stage.internal:8181
OPA_FAIL_CLOSED=true

# Staging Redis
REDIS_URL=redis://redis-stage.internal:6379/0

# Staging LiveKit
LIVEKIT_URL=wss://livekit-stage.internal/webrtc
LIVEKIT_API_KEY=STAGE_LIVEKIT_KEY
LIVEKIT_API_SECRET=STAGE_LIVEKIT_SECRET
STT_PROVIDER=mock
TTS_PROVIDER=mock
REASONING_PROVIDER=deterministic_mock

# Staging Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-stage.internal:4317
OTEL_SERVICE_NAME=sentinelx-staging-api
AUDIT_STORAGE_BACKEND=memory
AUDIT_FAIL_CLOSED=true
