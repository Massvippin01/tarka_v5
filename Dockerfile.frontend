# ==============================================================================
# SENTINELX FRONTEND DOCKERFILE (MULTI-STAGE)
# Stage 1: Build (Node 20 Alpine)
# Stage 2: Runtime (NGINX Unprivileged Alpine)
# ==============================================================================

# Stage 1: Build static assets
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies deterministically
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci --prefer-offline --no-audit

# Copy frontend source code
COPY frontend/ ./

# Compile TypeScript and bundle with Vite
RUN npm run build

# ==============================================================================
# Stage 2: Minimal, Unprivileged NGINX Runtime
FROM nginxinc/nginx-unprivileged:alpine-slim AS runner

# Copy compiled static assets from builder stage
COPY --from=builder --chown=nginx:nginx /app/dist /usr/share/nginx/html

# Copy unprivileged NGINX server configuration
COPY --chown=nginx:nginx frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Default unprivileged port
EXPOSE 8080

# Healthcheck validating the unprivileged NGINX endpoint
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://localhost:8080/healthz || exit 1

CMD ["nginx", "-g", "daemon off;"]
